    "papers/series-wise-validation/lab.yaml": {
      "before_sha256": "3581aaa9fa53d8152205fcde9123b21690b70419ce988408847285289c369e3b",
      "before_blob": "1740f93f8dbeb57cd34e27693fbe6b68e0151283",
