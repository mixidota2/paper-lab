    "papers/discounted-perishables-forecast/lab.yaml": {
      "before_sha256": "60cacb4eb26ef3bc95c4e3ac4cc4a2e3660f5431b417dc8eb36d287023be81c3",
      "before_blob": "86f16bd247c52cd2ce0e24a15384913ac86bf5f3",
