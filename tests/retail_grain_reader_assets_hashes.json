    "papers/retail-forecast-decision-grain/lab.yaml": {
      "before_sha256": "137b7321c069e28133cd583e6ea87329bd729451d6d03956fc1c883293f5a01a",
      "before_blob": "98f257cb68082de715d50b0df2f3b6173884eb79",
